#!/usr/bin/env bash
# sietch — global CLI for the agent-dev-loop framework.
#
# Sietch is a multi-agent dev loop modeled on Steve Yegge's GasTown,
# named after the Fremen community concept from Dune. Each consumer repo
# carries a single .sietch/rig.config; the framework code lives here in
# $SIETCH_HOME and is shared across every rig you onboard.
#
# Invoke from anywhere inside a repo that has .sietch/rig.config:
#   sietch dev                        # scan issues, claim one, drive a PR
#   sietch dev follow-up <PR>         # address reviewer-agent feedback
#   sietch dev resolve <PR>           # auto-resolve merge conflicts (triage-gated)
#   sietch review                     # dispatch a per-PR reviewer sub-agent
#   sietch issue [message]            # interactive issue author
#   sietch loop [start|stop|...]      # tmux multi-pane orchestrator
#   sietch triage <PR>                # decide whether a conflict is auto-resolvable
#   sietch init                       # bootstrap .sietch/rig.config in $PWD
#   sietch version                    # short SHA of the framework
#   sietch help                       # this message

set -u

SIETCH_HOME="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export SIETCH_HOME

usage() {
  sed -n '/^# sietch — /,/^# *sietch help/p' "$0" | sed -E 's/^# ?//'
}

# Walk up from $PWD until we find a .sietch/rig.config. Echoes the dir,
# returns 1 if not found.
find_repo_root() {
  local d="$PWD"
  while [ "$d" != "/" ] && [ -n "$d" ]; do
    if [ -f "$d/.sietch/rig.config" ]; then
      echo "$d"
      return 0
    fi
    d=$(dirname "$d")
  done
  return 1
}

require_repo_root() {
  REPO_ROOT="$(find_repo_root)" || {
    echo "[sietch] no .sietch/rig.config found in $PWD or any parent." >&2
    echo "Run 'sietch init' from your repo root to bootstrap one." >&2
    exit 1
  }
  export REPO_ROOT
}

cmd_init() {
  local dest="$PWD/.sietch"
  local config="$dest/rig.config"
  if [ -f "$config" ]; then
    echo "[sietch init] $config already exists. Edit it directly." >&2
    return 1
  fi
  mkdir -p "$dest"
  cp "$SIETCH_HOME/formulas/rig.config.example" "$config"
  cat > "$dest/README.md" <<EOF
# Sietch — agent-dev-loop config for this rig

This directory carries the per-rig configuration for the [Sietch](https://github.com/aniryou/sietch)
multi-agent dev loop. The framework itself lives in \`\$SIETCH_HOME\` (typically
\`~/code/sietch/\`); this directory holds only \`rig.config\`, which the framework
substitutes into prompt templates at invocation time.

## Edit rig.config

Set \`REPO_OWNER\`, \`REPO_NAME\`, severity labels, branch prefix, and any
project-specific overrides. Defaults are documented inline.

## Run the agents

From anywhere inside this repo:

    sietch dev          # scan issues, claim one, drive a PR
    sietch review       # review an open dev-agent PR
    sietch loop start   # run the full multi-agent fleet in tmux
    sietch help         # full command list
EOF
  echo "[sietch init] created $config"
  echo "[sietch init] edit it to set REPO_OWNER, REPO_NAME, etc."
}

cmd_version() {
  if [ -d "$SIETCH_HOME/.git" ]; then
    git -C "$SIETCH_HOME" describe --always --dirty 2>/dev/null \
      || git -C "$SIETCH_HOME" rev-parse --short HEAD 2>/dev/null \
      || echo "unknown"
  else
    echo "unknown (SIETCH_HOME is not a git repo)"
  fi
}

CMD="${1:-help}"
shift || true

case "$CMD" in
  help|-h|--help)  usage ;;
  version)         cmd_version ;;
  init)            cmd_init "$@" ;;
  dev|developer)   require_repo_root; exec "$SIETCH_HOME/wrappers/run-developer.sh" "$@" ;;
  review|reviewer) require_repo_root; exec "$SIETCH_HOME/wrappers/run-reviewer.sh" "$@" ;;
  issue|issues)    require_repo_root; exec "$SIETCH_HOME/wrappers/run-issue-author.sh" "$@" ;;
  loop)            require_repo_root; exec "$SIETCH_HOME/wrappers/run-loop.sh" "$@" ;;
  triage)          require_repo_root; exec "$SIETCH_HOME/wrappers/triage-conflict.sh" "$@" ;;
  *)
    echo "[sietch] unknown command: $CMD" >&2
    echo "Run 'sietch help' for the command list." >&2
    exit 2
    ;;
esac
