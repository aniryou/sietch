#!/usr/bin/env bash
# st — global CLI for loop (a multi-agent dev loop framework).
#
# Each consumer repo carries a single .loop/loop.config; the framework
# code lives here in $LOOP_HOME and is shared across every repo you onboard.
#
# Invoke from anywhere inside a repo that has .loop/loop.config:
#   st dev                        # scan issues, claim one, drive a PR
#   st dev follow-up <PR>         # address reviewer-agent feedback
#   st dev resolve <PR>           # auto-resolve merge conflicts (triage-gated)
#   st review                     # dispatch a per-PR reviewer sub-agent
#   st issue [message]            # interactive issue author
#   st loop [start|stop|...]      # tmux multi-pane orchestrator
#   st triage <PR>                # decide whether a conflict is auto-resolvable
#   st init                       # bootstrap .loop/loop.config in $PWD
#   st version                    # short SHA of the framework
#   st help                       # this message

set -u
\unalias -a 2>/dev/null || true

# Resolve symlinks so LOOP_HOME points at the real ~/code/loop/, not
# wherever ~/.local/bin/st happens to live.
src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  dir="$(cd -P "$(dirname "$src")" && pwd)"
  src="$(readlink "$src")"
  [[ "$src" != /* ]] && src="$dir/$src"
done
LOOP_HOME="$(cd -P "$(dirname "$src")/.." && pwd)"
export LOOP_HOME
unset src dir

usage() {
  sed -n '/^# st — /,/^# *st help/p' "$0" | sed -E 's/^# ?//'
}

# Walk up from $PWD until we find a .loop/loop.config. Echoes the dir,
# returns 1 if not found.
find_repo_root() {
  local d="$PWD"
  while [ "$d" != "/" ] && [ -n "$d" ]; do
    if [ -f "$d/.loop/loop.config" ]; then
      echo "$d"
      return 0
    fi
    d=$(dirname "$d")
  done
  return 1
}

require_repo_root() {
  REPO_ROOT="$(find_repo_root)" || {
    echo "[st] no .loop/loop.config found in $PWD or any parent." >&2
    echo "Run 'st init' from your repo root to bootstrap one." >&2
    exit 1
  }
  export REPO_ROOT
}

cmd_init() {
  local dest="$PWD/.loop"
  local config="$dest/loop.config"
  if [ -f "$config" ]; then
    echo "[st init] $config already exists. Edit it directly." >&2
    return 1
  fi
  mkdir -p "$dest"
  cp "$LOOP_HOME/templates/loop.config.example" "$config"
  cat > "$dest/README.md" <<EOF
# Loop — multi-agent dev-loop config for this repo

This directory carries the per-repo configuration for the [Loop](https://github.com/aniryou/loop)
multi-agent dev-loop framework. The framework itself lives in \`\$LOOP_HOME\` (typically
\`~/code/loop/\`); this directory holds only \`loop.config\`, which the framework
substitutes into prompt templates at invocation time.

## Edit loop.config

Set \`REPO_OWNER\`, \`REPO_NAME\`, severity labels, branch prefix, and any
project-specific overrides. Defaults are documented inline.

## Run the agents

From anywhere inside this repo:

    st dev          # scan issues, claim one, drive a PR
    st review       # review an open dev-agent PR
    st loop start   # run the full multi-agent fleet in tmux
    st help         # full command list
EOF
  echo "[st init] created $config"
  echo "[st init] edit it to set REPO_OWNER, REPO_NAME, etc."
}

cmd_version() {
  if [ -d "$LOOP_HOME/.git" ]; then
    git -C "$LOOP_HOME" describe --always --dirty 2>/dev/null \
      || git -C "$LOOP_HOME" rev-parse --short HEAD 2>/dev/null \
      || echo "unknown"
  else
    echo "unknown (LOOP_HOME is not a git repo)"
  fi
}

CMD="${1:-help}"
shift || true

case "$CMD" in
  help|-h|--help)  usage ;;
  version)         cmd_version ;;
  init)            cmd_init "$@" ;;
  dev|developer)   require_repo_root; exec "$LOOP_HOME/wrappers/run-developer.sh" "$@" ;;
  review|reviewer) require_repo_root; exec "$LOOP_HOME/wrappers/run-reviewer.sh" "$@" ;;
  issue|issues)    require_repo_root; exec "$LOOP_HOME/wrappers/run-issue-author.sh" "$@" ;;
  loop)            require_repo_root; exec "$LOOP_HOME/wrappers/run-loop.sh" "$@" ;;
  triage)          require_repo_root; exec "$LOOP_HOME/wrappers/triage-conflict.sh" "$@" ;;
  *)
    echo "[st] unknown command: $CMD" >&2
    echo "Run 'st help' for the command list." >&2
    exit 2
    ;;
esac
