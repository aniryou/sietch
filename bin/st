#!/usr/bin/env bash
# st — global CLI for loop (a multi-agent dev loop framework).
#
# Each consumer repo carries a single .loop/loop.config; the framework
# code lives here in $LOOP_HOME and is shared across every repo you onboard.
#
# Invoke from anywhere inside a repo that has .loop/loop.config:
#   st dev                                # scan issues, claim one, drive a PR
#   st dev --interactive <issue#>         # human-driven Mode 1 on a specific issue
#   st dev follow-up <PR>                 # address reviewer-agent feedback
#   st dev follow-up <PR> --interactive   # human-driven Mode 2
#   st dev resolve <PR>                   # auto-resolve merge conflicts (triage-gated)
#   st dev resolve <PR> --interactive     # human-driven Mode 3 (skips triage)
#   st review <PR>                # review a specific open dev-agent PR
#   st issue [message]            # interactive issue author
#   st loop [start|stop|...]      # tmux multi-pane orchestrator
#   st triage <PR>                # decide whether a conflict is auto-resolvable
#   st onboard [-v]               # audit this repo for loop's prerequisites
#   st init                       # bootstrap .loop/loop.config in $PWD
#   st version                    # short SHA of the framework
#   st help                       # this message

set -u
\unalias -a 2>/dev/null || true

# Resolve symlinks so LOOP_HOME points at the real ~/code/loop/, not
# wherever ~/.local/bin/st happens to live.
src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  dir="$(cd -P "$(dirname "$src")" && pwd)"
  src="$(readlink "$src")"
  [[ "$src" != /* ]] && src="$dir/$src"
done
LOOP_HOME="$(cd -P "$(dirname "$src")/.." && pwd)"
export LOOP_HOME
unset src dir

usage() {
  sed -n '/^# st — /,/^# *st help/p' "$0" | sed -E 's/^# ?//'
}

# Walk up from $PWD until we find a .loop/loop.config. Echoes the dir,
# returns 1 if not found.
find_repo_root() {
  local d="$PWD"
  while [ "$d" != "/" ] && [ -n "$d" ]; do
    if [ -f "$d/.loop/loop.config" ]; then
      echo "$d"
      return 0
    fi
    d=$(dirname "$d")
  done
  return 1
}

require_repo_root() {
  REPO_ROOT="$(find_repo_root)" || {
    echo "[st] no .loop/loop.config found in $PWD or any parent." >&2
    echo "Run 'st init' from your repo root to bootstrap one." >&2
    exit 1
  }
  export REPO_ROOT
}

cmd_init() {
  local dest="$PWD/.loop"
  local config="$dest/loop.config"

  if [ ! -f "$config" ]; then
    mkdir -p "$dest"
    cp "$LOOP_HOME/templates/loop.config.example" "$config"
    cat >"$dest/README.md" <<EOF
# Loop — multi-agent dev-loop config for this repo

This directory carries the per-repo configuration for the [Loop](https://github.com/aniryou/loop)
multi-agent dev-loop framework. The framework itself lives in \`\$LOOP_HOME\` (typically
\`~/code/loop/\`); this directory holds only \`loop.config\`, which the framework
substitutes into prompt templates at invocation time.

## Edit loop.config

Set \`REPO_OWNER\`, \`REPO_NAME\`, severity labels, branch prefix, and any
project-specific overrides. Defaults are documented inline.

## Run the agents

From anywhere inside this repo:

    st dev          # scan issues, claim one, drive a PR
    st review <PR>  # review a specific open dev-agent PR
    st loop start   # run the full multi-agent fleet in tmux
    st help         # full command list
EOF
    echo "[st init] created $config"
  else
    echo "[st init] $config already exists; preserving."
  fi

  cmd_init_autofill_config "$config"
  cmd_init_claude_md_block || true
  cmd_init_bootstrap_beads
  cmd_init_bootstrap_precommit

  echo ""
  echo "[st init] running embedded onboard..."
  # LOOP_HOME is already exported by the trampoline at the top of this
  # file; only REPO_ROOT needs to be set per-invocation here.
  REPO_ROOT="$PWD" bash "$LOOP_HOME/runners/lib/onboard.sh" run
}

# Auto-fill placeholder values in loop.config from repo state. Idempotent:
# only rewrites a KEY="value" line whose current value is the exact template
# placeholder, so any user-edit survives a re-run of `st init`.
cmd_init_autofill_config() {
  local config="$1"

  local origin_url owner="" name="" default_branch="" test_cmd=""
  if origin_url=$(git -C "$PWD" remote get-url origin 2>/dev/null); then
    # Match both forms:
    #   git@github.com:owner/repo(.git)?
    #   https://github.com/owner/repo(.git)?(/)?
    if [[ "$origin_url" =~ github\.com[:/]+([^/]+)/([^/.]+)(\.git)?/?$ ]]; then
      owner="${BASH_REMATCH[1]}"
      name="${BASH_REMATCH[2]}"
    fi
  fi

  if default_branch=$(git -C "$PWD" symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null); then
    default_branch="${default_branch#origin/}"
  fi
  if [ -z "$default_branch" ]; then
    default_branch=$(git -C "$PWD" branch --show-current 2>/dev/null || true)
  fi

  if [ -f "$PWD/pyproject.toml" ] || compgen -G "$PWD/requirements*.txt" >/dev/null; then
    test_cmd="pytest -q"
  elif [ -f "$PWD/package.json" ]; then
    test_cmd="npm test"
  elif [ -f "$PWD/go.mod" ]; then
    test_cmd="go test ./..."
  elif compgen -G "$PWD/tests/*.bats" >/dev/null; then
    test_cmd="bats tests/"
  fi

  [ -n "$owner" ]          && _replace_placeholder "$config" REPO_OWNER     'your-github-org-or-user' "$owner"
  [ -n "$name" ]           && _replace_placeholder "$config" REPO_NAME      'your-repo-name'          "$name"
  [ -n "$default_branch" ] && _replace_placeholder "$config" DEFAULT_BRANCH 'main'                    "$default_branch"
  [ -n "$test_cmd" ]       && _replace_placeholder "$config" TEST_CMD       'pytest -q'               "$test_cmd"
  return 0
}

# Rewrite a single KEY="..." line in $file iff its current value is exactly
# $placeholder. Skips when the user has already edited the line (any other
# value, or any whitespace/quote variation). Uses awk for value-literal
# matching so we don't have to escape sed metacharacters in $newval.
_replace_placeholder() {
  local file="$1" key="$2" placeholder="$3" newval="$4"
  if [ "$placeholder" = "$newval" ]; then
    return 0  # no-op: detected value matches the placeholder
  fi
  local tmp
  tmp=$(mktemp "${file}.XXXXXX") || return 1
  awk -v key="$key" -v ph="$placeholder" -v nv="$newval" '
    {
      if ($0 == key "=\"" ph "\"") {
        print key "=\"" nv "\""
      } else {
        print
      }
    }
  ' "$file" >"$tmp" && mv "$tmp" "$file"
}

# `bd init` if .beads/ is missing AND bd is on $PATH. Silent no-op
# otherwise — onboard's check_beads will report the missing tool case.
cmd_init_bootstrap_beads() {
  if [ -d "$PWD/.beads" ]; then
    return 0
  fi
  if ! command -v bd >/dev/null 2>&1; then
    return 0
  fi
  if ( cd "$PWD" && bd init >/dev/null 2>&1 ); then
    echo "[st init] ran 'bd init' (no .beads/ found)"
  else
    echo "[st init] 'bd init' failed; embedded onboard will report the failure" >&2
  fi
}

# `pre-commit install` if .pre-commit-config.yaml exists AND the hook is
# missing or doesn't carry the pre-commit framework marker. Silent no-op
# when pre-commit is not on $PATH — onboard's check_pre_commit_hook reports.
cmd_init_bootstrap_precommit() {
  if [ ! -f "$PWD/.pre-commit-config.yaml" ] && [ ! -f "$PWD/.pre-commit-config.yml" ]; then
    return 0
  fi
  local hook="$PWD/.git/hooks/pre-commit"
  if [ -f "$hook" ] && grep -qi 'pre-commit' "$hook"; then
    return 0
  fi
  if ! command -v pre-commit >/dev/null 2>&1; then
    return 0
  fi
  if ( cd "$PWD" && pre-commit install >/dev/null 2>&1 ); then
    echo "[st init] ran 'pre-commit install'"
  else
    echo "[st init] 'pre-commit install' failed; embedded onboard will report the failure" >&2
  fi
}

# Write a marker-bracketed LOOP INTEGRATION block into $PWD/CLAUDE.md.
# Idempotent: if a block already exists (any hash), leaves the file alone —
# refreshing stale blocks is the future `st sync` job, not `st init`.
cmd_init_claude_md_block() {
  local claude_md="$PWD/CLAUDE.md"
  local template="$LOOP_HOME/templates/claude-md-block.md"

  if [ -f "$claude_md" ] && grep -qF '<!-- BEGIN LOOP INTEGRATION' "$claude_md"; then
    echo "[st init] $claude_md already has a LOOP INTEGRATION block; leaving alone."
    return 0
  fi

  if [ ! -f "$template" ]; then
    echo "[st init] missing template: $template" >&2
    return 1
  fi

  # LOOP_HOME is already exported by the trampoline at top of this file;
  # only REPO_ROOT needs to be set per-invocation here.
  local rendered
  rendered=$(REPO_ROOT="$PWD" \
    bash "$LOOP_HOME/runners/lib/render-prompt.sh" "$template") || {
    echo "[st init] failed to render $template" >&2
    return 1
  }

  local hash
  hash=$(printf '%s' "$rendered" | shasum -a 256 | cut -c1-8)

  local block
  block=$(printf '<!-- BEGIN LOOP INTEGRATION v:1 hash:%s -->\n%s\n<!-- END LOOP INTEGRATION -->\n' \
    "$hash" "$rendered")

  if [ -f "$claude_md" ]; then
    # Append, separated from prior content by a single blank line.
    printf '\n%s' "$block" >>"$claude_md"
    echo "[st init] appended LOOP INTEGRATION block to $claude_md"
  else
    printf '# %s\n\n%s' "$(basename "$PWD")" "$block" >"$claude_md"
    echo "[st init] created $claude_md with LOOP INTEGRATION block"
  fi
}

cmd_version() {
  if [ -d "$LOOP_HOME/.git" ]; then
    git -C "$LOOP_HOME" describe --always --dirty 2>/dev/null \
      || git -C "$LOOP_HOME" rev-parse --short HEAD 2>/dev/null \
      || echo "unknown"
  else
    echo "unknown (LOOP_HOME is not a git repo)"
  fi
}

CMD="${1:-help}"
shift || true

case "$CMD" in
  help | -h | --help) usage ;;
  version) cmd_version ;;
  init) cmd_init "$@" ;;
  dev | developer)
    require_repo_root
    exec "$LOOP_HOME/runners/run-developer.sh" "$@"
    ;;
  review | reviewer)
    require_repo_root
    exec "$LOOP_HOME/runners/run-reviewer.sh" "$@"
    ;;
  issue | issues)
    require_repo_root
    exec "$LOOP_HOME/runners/run-issue-author.sh" "$@"
    ;;
  loop)
    require_repo_root
    exec "$LOOP_HOME/runners/run-loop.sh" "$@"
    ;;
  triage)
    require_repo_root
    exec "$LOOP_HOME/runners/run-conflict-triage.sh" "$@"
    ;;
  onboard)
    require_repo_root
    exec bash "$LOOP_HOME/runners/lib/onboard.sh" "${@:-run}"
    ;;
  *)
    echo "[st] unknown command: $CMD" >&2
    echo "Run 'st help' for the command list." >&2
    exit 2
    ;;
esac
